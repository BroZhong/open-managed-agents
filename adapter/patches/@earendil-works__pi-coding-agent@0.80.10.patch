index 0000000000000000000000000000000000000000..ae2da57f069c4db01284389859c584bcf6fe14b5
--- /dev/null
+++ b/dist/core/tools/search-process.d.ts
@@ -0,0 +1,18 @@
+import type { Readable } from "node:stream";
+
+/** The process surface consumed by Pi's native search implementations. */
+export interface SearchToolProcess {
+    stdout: Readable;
+    stderr: Readable | null;
+    killed: boolean;
+    kill(): boolean;
+    on(event: "error", listener: (error: Error) => void): this;
+    on(event: "close", listener: (code: number | null) => void): this;
+}
+
+/** Starts the original rg/fd argv without replacing Pi's search semantics. */
+export type SearchToolSpawn = (
+    command: string,
+    args: string[],
+    options: { stdio: ["ignore", "pipe", "pipe"] },
+) => SearchToolProcess;
