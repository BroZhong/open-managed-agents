# Web console local configuration — copy to `.env.local` and edit.
#
#   cp web/.env.example web/.env.local
#
# Vite reads `.env.local` (git-ignored, machine-local) with higher priority than
# the committed defaults, so you can point the local dev server at any backend
# without touching tracked files. Vars must be prefixed VITE_ to reach the app.
# Restart `pnpm dev` after changing this file — Vite inlines env at startup.

# Base URL of the OMA API server the console talks to.
#   - Local backend (default):   http://localhost:3000
#   - Remote / online endpoint:  https://your-oma-host.example.com
VITE_API_URL=http://localhost:3000
