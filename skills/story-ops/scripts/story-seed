  story-seed ops:feedback [--json]
  story-seed smoke
`;
}

function slugify(input) {
  const s = String(input || "").trim();
  const slug = s
    .normalize("NFKC")
    .replace(/[^\p{Letter}\p{Number}\s._-]/gu, "")
    .trim()
    .replace(/[\s_]+/gu, "-")
    .replace(/-+/gu, "-")
    .replace(/^\.+|\.+$/gu, "")
    .toLowerCase();
  return slug || `untitled-project-${contentHash(s || "untitled-project").slice(0, 8)}`;
}

function legacySlugify(input) {
  const s = String(input || "").trim();
  return s
    .normalize("NFKD")
    .replace(/[^\w\s-]/g, "")
    .trim()
    .replace(/[\s_]+/g, "-")
    .replace(/-+/g, "-")
    .toLowerCase() || "untitled-project";
}

function projectsRoot() {
  return path.join(WORKSPACE, "项目");
}

function projectDirForInit(projectId) {
  const preferred = path.join(projectsRoot(), slugify(projectId));
  const legacySlug = legacySlugify(projectId);
  const legacy = path.join(projectsRoot(), legacySlug);
  if (!fs.existsSync(preferred) && legacySlug !== "untitled-project" && fs.existsSync(legacy)) return legacy;
  return preferred;
}

function isSafeProjectName(value) {
  const name = String(value || "").trim();
  return Boolean(name)
    && name !== "."
    && name !== ".."
    && !name.includes("/")
    && !name.includes("\\");
}

function realpathIfExists(target) {
  try {
    return fs.realpathSync(target);
  } catch {
    return "";
  }
}

function isInside(parent, child) {
  const parentReal = realpathIfExists(parent);
  const childReal = realpathIfExists(child);
  if (!parentReal || !childReal) return false;
  const rel = path.relative(parentReal, childReal);
  return rel === "" || (rel && !rel.startsWith("..") && !path.isAbsolute(rel));
}

function ensureDir(dir) {
  fs.mkdirSync(dir, { recursive: true });
}

function writeIfMissing(file, text) {
  if (!fs.existsSync(file)) {
    fs.writeFileSync(file, text, "utf8");
  }
}

