{
  "name": "@welltop/oma-cli",
  "version": "0.0.2",
  "description": "Non-interactive OMA CLI",
  "type": "module",
  "bin": {
    "oma-cli": "dist/main.js"
  },
  "files": [
    "dist",
    "guides",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
