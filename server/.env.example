# Example only. Replace placeholders using your authorized secret source.
# Load this file through your process supervisor or an explicit shell export;
# dev-server.ts does not automatically read server/.env. Never commit .env.
PORT=3000
AUTH_DISABLED=false

# Keep the existing application database and Redis endpoints; this storage
# replacement does not move them to the Shanghai Sandbox cluster.
PG_HOST=replace-with-existing-postgres-host
PG_PORT=5432
PG_DATABASE=replace-with-existing-database
PG_USER=replace-with-existing-application-user
PG_PASSWORD=replace-with-postgres-secret
PG_SCHEMA=oma
PG_SSL=false
PG_ENSURE_SCHEMA=false
REDIS_HOST=replace-with-existing-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-redis-secret

# Skills retain their existing Supabase Storage endpoint, service key and bucket.
# SUPABASE_STORAGE_URL / SUPABASE_SERVICE_KEY are also accepted aliases.
S3_ENDPOINT=https://replace-with-existing-supabase-host/storage/v1
S3_SERVICE_KEY=replace-with-supabase-service-key
S3_BUCKET=workspace

# Mandatory Host Workspace storage. Region and bucket must agree with CSI.
WORKSPACE_OSS_REGION=oss-cn-shanghai
WORKSPACE_OSS_BUCKET=agentry
WORKSPACE_OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
WORKSPACE_OSS_PUBLIC_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
WORKSPACE_OSS_ACCESS_KEY_ID=replace-with-host-oss-access-key-id
WORKSPACE_OSS_ACCESS_KEY_SECRET=replace-with-host-oss-access-key-secret
# Optional for temporary Host credentials; env-injected STS is not auto-refreshed.
# WORKSPACE_OSS_STS_TOKEN=replace-with-host-sts-token

# Separate Shanghai Sandbox identity resources. Never pass Host OSS credentials
# into Agent env or E2B metadata. Host computes the authorized object prefix.
WORKSPACE_OSS_AGENT_NAME=agentry-workspace
WORKSPACE_OSS_PV_NAME=agentry-workspace-oss
WORKSPACE_OSS_CREDENTIAL_PROVIDER=agentry-oss-rw
SANDBOX_ENABLED=true
SANDBOX_TEMPLATE=auto-story-v2
E2B_DOMAIN=sandbox.agentry.welltop.tech
E2B_API_KEY=replace-with-shanghai-e2b-gateway-key
E2B_REQUEST_TIMEOUT_MS=185000

# Optional outside Kubernetes; configure both to enable native shared sandbox
# credentials. The Host ServiceAccount needs get access to this one Secret.
# Values are read at startup, kept in memory and passed to E2B create.envs.
# SANDBOX_BASE_SECRET_NAMESPACE=sandbox-system
# SANDBOX_BASE_SECRET_NAME=base-secret

# Optional existing Host proxy / tool integrations; no credentials shown.
# OMA_PROXY_URL=http://replace-with-existing-proxy-host:7890
# DEFAULT_SANDBOX_VFS_TOKEN=replace-with-authorized-vfs-token
# OpenGrove WW stays disabled unless all three Host variables are configured
# together, including an explicit Agent allowlist; see deploy/k8s.yaml.
