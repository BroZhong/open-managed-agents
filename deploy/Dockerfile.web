# Open Managed Agents Web Console — static build served by nginx.
# Build context is the repo root. VITE_API_URL is baked at build time.
# The Vite output is architecture-neutral. Build it on the builder's native
# platform (avoids flaky Node/QEMU segfaults on Apple Silicon) and keep only the
# final nginx image on the requested deployment platform.
#
# Built and published by deploy/scripts/build-base-images.sh. Normal builds use
# only the Shanghai ACR and do not depend on Docker Hub or a Corepack download.
ARG NODE_BASE=registry-vpc.cn-shanghai.aliyuncs.com/welltop/node-base:22-slim-pnpm-10.12.4
ARG NGINX_BASE=registry-vpc.cn-shanghai.aliyuncs.com/welltop/nginx-base:1.27-alpine

FROM --platform=$BUILDPLATFORM ${NODE_BASE} AS build
WORKDIR /app/web
COPY web/ ./
ENV CI=true
RUN pnpm install --no-frozen-lockfile
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN pnpm build

FROM --platform=$TARGETPLATFORM ${NGINX_BASE}
COPY --from=build /app/web/dist /usr/share/nginx/html
# The public Ingress routes the complete /api prefix directly to oma-server.
# Keeping the Web image free of an in-cluster upstream also avoids startup
# failures on ACS, where Service-name DNS can briefly return NXDOMAIN.
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
