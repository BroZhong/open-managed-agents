# Nautilus Web Console — static build served by nginx.
# Build context is the repo root. VITE_API_URL is baked at build time.
# The Vite output is architecture-neutral. Build it on the builder's native
# platform (avoids flaky Node/QEMU segfaults on Apple Silicon) and keep only the
# final nginx image on the requested deployment platform.
FROM --platform=$BUILDPLATFORM node:22-slim AS build
RUN corepack enable && corepack prepare pnpm@10.12.4 --activate
WORKDIR /app/web
COPY web/ ./
ENV CI=true
RUN pnpm install --no-frozen-lockfile
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN pnpm build

FROM --platform=$TARGETPLATFORM nginx:1.27-alpine
COPY --from=build /app/web/dist /usr/share/nginx/html
# The public gateway sends unmatched paths to the Web service. Keep the
# machine-readable contract out of the SPA fallback and forward it to the API
# service in the same Kubernetes namespace.
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location = /openapi.json {\n    proxy_pass http://oma-server:3000/openapi.json;\n    proxy_set_header Host $host;\n    proxy_set_header X-Forwarded-Proto $scheme;\n  }\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
