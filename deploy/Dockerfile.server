# Open Managed Agents Server (Host) image — agent-platform / cn-shanghai
# Build context is the repo root.
#
# Built and published by deploy/scripts/build-base-images.sh. The image pins
# Node and pnpm so normal source builds never need Docker Hub or Corepack fetches.
ARG NODE_BASE=registry-vpc.cn-shanghai.aliyuncs.com/welltop/node-base:22-slim-pnpm-10.12.4
FROM ${NODE_BASE} AS base
ARG TARGETARCH

WORKDIR /app
# Pi's extension installer shells out to npm. Audit/funding/update checks add no
# value to an immutable image build and can each wait minutes on endpoints that
# are slow or unavailable from the Shanghai builder, so disable them globally.
ENV CI=true \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_PREFER_OFFLINE=true

FROM base AS manifests

# ─── Dependency layer (cached across source-only changes) ───────────────────
# Copy ONLY the workspace manifests + lockfiles first, so `pnpm install` is its
# own layer that stays cached unless a package.json / lockfile actually changes.
# Editing a .ts file no longer busts the (slow, amd64-emulated) install step.
# The server workspace depends on the adapter core via a file: path, so both
# workspaces' manifests must be present.
COPY adapter/pnpm-workspace.yaml adapter/package.json adapter/pnpm-lock.yaml ./adapter/
COPY adapter/patches/ ./adapter/patches/
COPY server/pnpm-workspace.yaml server/package.json server/pnpm-lock.yaml ./server/
COPY server/patches/ ./server/patches/
# BEGIN WORKSPACE PACKAGE MANIFESTS
# deploy/scripts/build-images.sh regenerates this block in a temporary
# Dockerfile from the current workspace, preventing new packages from being
# omitted while preserving the dependency-layer cache.
COPY adapter/packages/claude-code/package.json ./adapter/packages/claude-code/
COPY adapter/packages/codex/package.json ./adapter/packages/codex/
COPY adapter/packages/core/package.json ./adapter/packages/core/
COPY adapter/packages/mock/package.json ./adapter/packages/mock/
COPY adapter/packages/pi-agent/package.json ./adapter/packages/pi-agent/
COPY adapter/packages/runner/package.json ./adapter/packages/runner/
COPY adapter/packages/tool-executor-local/package.json ./adapter/packages/tool-executor-local/

COPY server/packages/api/package.json ./server/packages/api/
COPY server/packages/event-log/package.json ./server/packages/event-log/
COPY server/packages/mcp-catalog/package.json ./server/packages/mcp-catalog/
COPY server/packages/redis/package.json ./server/packages/redis/
COPY server/packages/sandbox/package.json ./server/packages/sandbox/
COPY server/packages/session-router/package.json ./server/packages/session-router/
COPY server/packages/store/package.json ./server/packages/store/
COPY server/packages/store-memory/package.json ./server/packages/store-memory/
# END WORKSPACE PACKAGE MANIFESTS

# Copy each workspace separately from the manifest stage: a server dependency
# change must not invalidate the adapter or Pi extension layers.
FROM base AS adapter-deps
COPY --from=manifests /app/adapter/ ./adapter/
RUN --mount=type=cache,id=oma-pnpm-${TARGETARCH},target=/root/.local/share/pnpm/store,sharing=locked \
    cd /app/adapter && pnpm install --no-frozen-lockfile --prefer-offline

FROM adapter-deps AS pi-seed

# Pi extensions used by every managed Pi runtime. Install them with Pi's own
# package manager (rather than merely adding npm dependencies) so the generated
# settings.json + package tree are exactly what DefaultResourceLoader discovers
# at runtime. Production uses /opt/pi-agent-seed directly, with auth.json and
# models.json mounted read-only from oma-pi-gateway. Settings and extensions
# remain part of the release image.
ARG PI_WEB_ACCESS_VERSION=0.13.0
RUN --mount=type=cache,id=oma-npm-${TARGETARCH},target=/root/.npm,sharing=locked \
    PI_CODING_AGENT_DIR=/opt/pi-agent-seed \
      /app/adapter/packages/pi-agent/node_modules/.bin/pi install \
      npm:pi-web-access@${PI_WEB_ACCESS_VERSION}
ARG PI_MCP_ADAPTER_VERSION=2.11.0
RUN --mount=type=cache,id=oma-npm-${TARGETARCH},target=/root/.npm,sharing=locked \
    PI_CODING_AGENT_DIR=/opt/pi-agent-seed \
      /app/adapter/packages/pi-agent/node_modules/.bin/pi install \
      npm:pi-mcp-adapter@${PI_MCP_ADAPTER_VERSION}
COPY deploy/patch-pi-mcp-adapter.mjs /tmp/patch-pi-mcp-adapter.mjs
RUN node /tmp/patch-pi-mcp-adapter.mjs \
      /opt/pi-agent-seed/npm/node_modules/pi-mcp-adapter

# Delegation is implemented by the Host and its three Adapter tools.
COPY deploy/pi-models.json /opt/pi-agent-seed/models.json

# ─── Source layer (changes on every code edit; deps above stay cached) ──────
FROM adapter-deps AS runtime
COPY --from=manifests /app/server/ ./server/
RUN --mount=type=cache,id=oma-pnpm-${TARGETARCH},target=/root/.local/share/pnpm/store,sharing=locked \
    cd /app/server && pnpm install --no-frozen-lockfile --prefer-offline
COPY --from=pi-seed /opt/pi-agent-seed/ /opt/pi-agent-seed/
COPY adapter/ ./adapter/
COPY server/ ./server/

# Re-run install so any manifest not copied above (or workspace linking) settles.
# With the deps already installed + cached in the store, this is near-instant.
RUN --mount=type=cache,id=oma-pnpm-${TARGETARCH},target=/root/.local/share/pnpm/store,sharing=locked \
    cd /app/adapter && pnpm install --no-frozen-lockfile --prefer-offline \
 && cd /app/server && pnpm install --no-frozen-lockfile --prefer-offline

ENV PORT=3000
EXPOSE 3000

# Entrypoint: the full PG + Redis + OSS Workspace + Supabase Skills + sandbox wiring (config-driven from env).
WORKDIR /app/server/packages/api
CMD ["pnpm", "exec", "tsx", "src/dev-server.ts"]
