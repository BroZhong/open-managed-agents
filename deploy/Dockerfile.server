# Nautilus Server (Host) image — brozhong ACS HK
# Build context is the repo root.
FROM node:22-slim

RUN corepack enable && corepack prepare pnpm@10.12.4 --activate

WORKDIR /app

# The server workspace depends on the adapter core via file: path (../../../adapter/packages/core),
# so both workspaces must be present in the image.
COPY adapter/ ./adapter/
COPY server/ ./server/

# Install adapter workspace first (server references it by relative path)
WORKDIR /app/adapter
ENV CI=true
RUN pnpm install --no-frozen-lockfile

WORKDIR /app/server
RUN pnpm install --no-frozen-lockfile

ENV PORT=3000
EXPOSE 3000

# Production entrypoint (PostgreSQL + Redis + S3-backed). tsx runs TS directly.
WORKDIR /app/server/packages/api
CMD ["pnpm", "exec", "tsx", "src/prod-server.ts"]
