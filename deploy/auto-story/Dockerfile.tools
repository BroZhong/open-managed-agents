# Source-only Pi tool overlay for a base that already has native filesystem,
# process-byte, mutation, preview and output-sink support. Older bases must
# first be rebuilt with deploy/Dockerfile.server.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
RUN cd /app/server/packages/api && node --input-type=module -e '\
  import { existsSync, readFileSync } from "node:fs"; \
  import { createRequire } from "node:module"; \
  import { dirname, join } from "node:path"; \
  import { fileURLToPath } from "node:url"; \
  try { \
    const adapter = fileURLToPath(import.meta.resolve("@open-managed-agents/adapter-pi-agent")); \
    const piName = "@earendil-works/pi-coding-agent"; \
    const pi = createRequire(adapter).resolve.paths(piName).map(p => join(p, piName)).find(p => existsSync(join(p, "package.json"))); \
    const requireText = (file, text) => { if (!readFileSync(file, "utf8").includes(text)) throw new Error(file + " lacks " + text); }; \
    requireText(join(pi, "dist/index.js"), "detectSupportedImageMimeType"); \
    for (const tool of ["grep", "find"]) { \
      requireText(join(pi, "dist/core/tools", tool + ".js"), "options?.spawn ?? spawn"); \
      requireText(join(pi, "dist/core/tools", tool + ".js"), "options?.homeDir"); \
    } \
    const requireTool = (file, texts) => { for (const text of texts) requireText(join(pi, "dist/core/tools", file + ".js"), text); }; \
    requireTool("path-utils", ["options?.homeDir", "options?.exists"]); \
    requireTool("read", ["options?.homeDir", "ops.exists"]); \
    requireTool("ls", ["options?.homeDir"]); \
    for (const tool of ["edit", "write"]) requireTool(tool, ["options?.homeDir", "options?.mutationScope", "realpath: ops.realpath"]); \
    requireTool("edit", ["operations: options?.operations", "ops.access(path, constants.R_OK)"]); \
    requireTool("edit-diff", ["options.operations.access", "options.operations.readFile"]); \
    requireTool("file-mutation-queue", ["new WeakMap()", "options?.scope", "options?.realpath"]); \
    requireTool("bash", ["options?.env", "createOutputSink: options?.createOutputSink"]); \
    requireTool("output-accumulator", ["this.createOutputSink", "enqueueSinkWrite", "await sink.close()"]); \
    const core = fileURLToPath(import.meta.resolve("@open-managed-agents/adapter-core")); \
    requireText(join(dirname(core), "tool-executor.ts"), "readonly fileSystem?: ToolFileSystem"); \
    requireText(join(dirname(core), "tool-executor.ts"), "bytes?: Uint8Array"); \
    const sandbox = fileURLToPath(import.meta.resolve("@oma-server/sandbox")); \
    requireText(join(dirname(sandbox), "sandbox-manager.ts"), "onExit: opts?.onExit"); \
    requireText(join(dirname(sandbox), "sandbox-manager.ts"), "this.sandboxClient.fileSystem(id)"); \
    requireText(join(dirname(sandbox), "sandbox-file-system.ts"), "createSandboxFileSystem"); \
    requireText(join(dirname(sandbox), "sandbox-file-system.ts"), "fs.lstat(request.path)"); \
    requireText(join(dirname(sandbox), "e2b-sandbox-client.ts"), "opts.onExit?.(exitResult)"); \
    requireText(join(dirname(sandbox), "e2b-sandbox-client.ts"), "handle.kill()"); \
    requireText(join(dirname(sandbox), "e2b-sandbox-client.ts"), "onStdoutBytes: pushBytes"); \
    const e2bDist = dirname(createRequire(sandbox).resolve("e2b")); \
    for (const file of ["index.js", "index.mjs"]) { \
      for (const text of ["stdoutDecoder.decode", "this.onStdoutBytes", "opts.onStderrBytes"]) requireText(join(e2bDist, file), text); \
    } \
  } catch (error) { throw new Error("BASE_IMAGE lacks native Pi I/O prerequisites; rebuild with deploy/Dockerfile.server before applying this overlay. " + error.message); }'
COPY adapter/packages/pi-agent/src/custom-tools.ts /app/adapter/packages/pi-agent/src/custom-tools.ts
COPY adapter/packages/pi-agent/src/native-files.ts /app/adapter/packages/pi-agent/src/native-files.ts
COPY adapter/packages/pi-agent/src/mutation-path.ts /app/adapter/packages/pi-agent/src/mutation-path.ts
COPY adapter/packages/pi-agent/src/sandbox-search.ts /app/adapter/packages/pi-agent/src/sandbox-search.ts
COPY adapter/packages/pi-agent/src/translator.ts /app/adapter/packages/pi-agent/src/translator.ts
# pnpm file: dependencies are snapshots. Refresh the actual API import target,
# too, without reinstalling or changing any pinned dependency.
RUN cd /app/server/packages/api && node --input-type=module -e '\
  import { copyFileSync } from "node:fs"; \
  import { dirname, join } from "node:path"; \
  import { fileURLToPath } from "node:url"; \
  const target = dirname(fileURLToPath(import.meta.resolve("@open-managed-agents/adapter-pi-agent"))); \
  for (const file of ["custom-tools.ts", "native-files.ts", "mutation-path.ts", "sandbox-search.ts", "translator.ts"]) \
    copyFileSync(join("/app/adapter/packages/pi-agent/src", file), join(target, file));'
