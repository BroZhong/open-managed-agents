ARG UPSTREAM_IMAGE=registry-vpc.cn-shanghai.aliyuncs.com/welltop/node-base:22-slim
FROM ${UPSTREAM_IMAGE}

ARG PNPM_VERSION=10.12.4
RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate \
 && node --version \
 && pnpm --version

LABEL org.opencontainers.image.title="OMA Node build base" \
      org.opencontainers.image.description="Node 22 slim with the OMA-pinned pnpm toolchain"
